# Copy of the variables JALWE V4 reads. Do not commit real secrets.

ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Hard lock stays in code. These must remain paper-only.
JALWE_PAPER_TRADING=true
JALWE_AUTO_PAPER_EXECUTION=false
JALWE_BROKER_SUBMISSION=false

# Entry buys use capped DAY limits; remaining quantity is canceled after timeout.
# Risk sizing uses the same ceiling.
JALWE_MAX_ENTRY_SLIPPAGE_PCT=0.35

# On Railway, mount a volume at /app/data and set both paths there.
JALWE_DATABASE_PATH=/app/data/jalwe_v4.db
JALWE_CONTROLLER_DATA_DIR=/app/data

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Suppress research/trigger messages; keep fills, protection and error alerts.
JALWE_QUIET_RESEARCH_ALERTS=true

JALWE_STARTING_CAPITAL=100
JALWE_CAPITAL_MODE=strategy_wallet

# Pre/post-market exits require fresh live SIP quotes and DAY limits.
JALWE_EXTENDED_EXIT_ENABLED=true
JALWE_MAX_EXIT_SLIPPAGE_PCT=0.35
